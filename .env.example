# UniShield environment variables
# Copy this to .env and adjust values

# --- Application ---
UNISHIELD_ENV=development
UNISHIELD_DEBUG=true
UNISHIELD_LOG_LEVEL=INFO

# --- Database ---
# SQLite (default for local dev)
UNISHIELD_DB_URL=sqlite+aiosqlite:///./data/unishield.db
# PostgreSQL (production)
# UNISHIELD_DB_URL=postgresql+asyncpg://unishield:password@localhost:5432/unishield

# --- API ---
UNISHIELD_API_HOST=127.0.0.1
UNISHIELD_API_PORT=8000

# --- Dashboard ---
UNISHIELD_DASHBOARD_PORT=8501

# --- Security ---
UNISHIELD_ANONYMIZE_IPS=false
UNISHIELD_IP_HASH_SALT=change-this-salt-in-production

# --- Processing ---
UNISHIELD_WINDOW_SIZE_SEC=10
UNISHIELD_SLIDE_INTERVAL_SEC=5
UNISHIELD_MAX_QUEUE_SIZE=10000
UNISHIELD_MAX_ALERT_BATCH=100

# --- Paths ---
UNISHIELD_DATA_DIR=./data
UNISHIELD_MODELS_DIR=./models
UNISHIELD_CONFIG_DIR=./configs
