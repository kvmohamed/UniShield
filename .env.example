# UniShield environment variables
# Copy this file to .env (in the directory you start UniShield from) and adjust.
# Only the variables below are read; they override configs/config.yaml.
# The four security flags (read-only, no decryption, no active scanning,
# no response path) cannot be changed from the environment.
# Service installs: deploy/systemd/unishield.env and docs/deployment.md.

# --- Application ---
UNISHIELD_ENV=development
UNISHIELD_DEBUG=true
UNISHIELD_LOG_LEVEL=INFO

# --- API ---
UNISHIELD_API_HOST=127.0.0.1
UNISHIELD_API_PORT=8000
# UNISHIELD_API_RELOAD=true            # auto-reload on code changes (development only)
# UNISHIELD_API_DOCS=false             # turn off /docs, /redoc, /openapi.json (production)
# Reverse proxies whose X-Forwarded-For/-Proto are trusted (comma-separated)
# UNISHIELD_FORWARDED_ALLOW_IPS=127.0.0.1

# --- HTTPS served by UniShield itself (or terminate TLS at a reverse proxy) ---
# UNISHIELD_TLS_CERTFILE=/etc/unishield/tls/fullchain.pem
# UNISHIELD_TLS_KEYFILE=/etc/unishield/tls/privkey.pem
# UNISHIELD_TLS_KEYFILE_PASSWORD=

# --- Accounts ---
# accounts (default): every data endpoint needs a login or a service token.
# open: LAB ONLY - reads without login; refused when UNISHIELD_ENV=production.
# There are no default accounts: unishield-admin user create <name> --role admin
# UNISHIELD_AUTH_MODE=accounts
# UNISHIELD_COOKIE_SECURE=auto         # auto | always | never

# Static service token for automation (X-API-Key header), acting with
# UNISHIELD_API_KEY_ROLE. Prefer named, revocable tokens:
#   unishield-admin token create --name siem --role viewer --expires-days 90
# UNISHIELD_ADMIN_API_KEY=generate-a-long-random-value
# UNISHIELD_API_KEY_ROLE=admin         # viewer | analyst | admin

# --- Processing ---
UNISHIELD_WINDOW_SIZE_SEC=10
UNISHIELD_SLIDE_INTERVAL_SEC=5

# --- Privacy ---
UNISHIELD_ANONYMIZE_IPS=false
UNISHIELD_IP_HASH_SALT=change-this-salt-in-production

# --- Paths ---
# UNISHIELD_CONFIG_DIR=./configs
# UNISHIELD_LOGS_DIR=./logs
# UNISHIELD_DATA_DIR=./data          # replay API reads files only under this directory

# --- Site files (relative to the configs directory, or absolute) ---
# UNISHIELD_ASSETS_FILE=assets.yaml               # asset inventory (roles of known hosts)
# UNISHIELD_THRESHOLDS_FILE=thresholds.site.yaml  # overlay from scripts/learn_baseline.py

# --- Restart-safe detector state (beacon histories, baselines, Isolation Forest) ---
# UNISHIELD_STATE_ENABLED=false
# UNISHIELD_STATE_FILE=./data/state/pipeline_state.json

# Detection mode: rules | hybrid | ml (hybrid/ml need scripts/train_models.py first)
# UNISHIELD_DETECTION_MODE=rules

# --- Database ---
# SQLite default; PostgreSQL: postgresql+psycopg://user:password@host/unishield
# (pip install -e ".[postgres]"). Schema changes: unishield-admin db upgrade
# UNISHIELD_DB_URL=sqlite:///./data/unishield.db
# Delete alerts stored more than N days ago (unset: keep forever)
# UNISHIELD_ALERT_RETENTION_DAYS=90

# --- Exports (analyst side) ---
# UNISHIELD_EXPORT_DIR=./exports
# UNISHIELD_EXPORT_CONTINUOUS=false   # true: append new alerts/incidents to rotating files

# --- Secrets for analyst-side outputs (outbound: in configs/config.yaml) ---
# Read only from the environment, never from the config file.
# UNISHIELD_SMTP_PASSWORD=...          # name set by outbound.email.password_env
# UNISHIELD_WEBHOOK_AUTH=Bearer ...    # any name referenced by webhook headers_from_env
