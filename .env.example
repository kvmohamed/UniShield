# UniShield environment variables
# Copy this file to .env (in the directory you start UniShield from) and adjust.
# Only the variables below are read; they override configs/config.yaml.
# The four security flags (read-only, no decryption, no active scanning,
# no response path) cannot be changed from the environment.

# --- Application ---
UNISHIELD_ENV=development
UNISHIELD_DEBUG=true
UNISHIELD_LOG_LEVEL=INFO

# --- API ---
UNISHIELD_API_HOST=127.0.0.1
UNISHIELD_API_PORT=8000

# --- Processing ---
UNISHIELD_WINDOW_SIZE_SEC=10
UNISHIELD_SLIDE_INTERVAL_SEC=5

# --- Privacy ---
UNISHIELD_ANONYMIZE_IPS=false
UNISHIELD_IP_HASH_SALT=change-this-salt-in-production

# --- Paths ---
# UNISHIELD_CONFIG_DIR=./configs
# UNISHIELD_LOGS_DIR=./logs
# UNISHIELD_DATA_DIR=./data          # replay API reads files only under this directory

# Detection mode: rules | hybrid | ml (hybrid/ml need scripts/train_models.py first)
# UNISHIELD_DETECTION_MODE=rules

# Alert database (SQLite default; PostgreSQL by URL)
# UNISHIELD_DB_URL=sqlite:///./data/unishield.db

# Key for administrative API endpoints (X-API-Key header). Without it,
# replay/demo/clear endpoints accept requests from loopback only.
# UNISHIELD_ADMIN_API_KEY=generate-a-long-random-value
