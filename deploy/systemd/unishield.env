# /etc/unishield/unishield.env - read by deploy/systemd/unishield.service.
# Mode 0640, owner root, group unishield: it may hold secrets.

UNISHIELD_ENV=production
UNISHIELD_DEBUG=false
UNISHIELD_LOG_LEVEL=INFO

# Listen on loopback behind a reverse proxy (deploy/nginx, deploy/caddy) ...
UNISHIELD_API_HOST=127.0.0.1
UNISHIELD_API_PORT=8000
UNISHIELD_FORWARDED_ALLOW_IPS=127.0.0.1
# ... or serve HTTPS directly (then listen on the interface clients use):
# UNISHIELD_API_HOST=0.0.0.0
# UNISHIELD_TLS_CERTFILE=/etc/unishield/tls/fullchain.pem
# UNISHIELD_TLS_KEYFILE=/etc/unishield/tls/privkey.pem

# Interactive API docs load Swagger UI from a CDN and need no login.
UNISHIELD_API_DOCS=false
UNISHIELD_AUTH_MODE=accounts

UNISHIELD_DB_URL=sqlite:////var/lib/unishield/unishield.db
# UNISHIELD_DB_URL=postgresql+psycopg://unishield:<password>@localhost/unishield
UNISHIELD_DATA_DIR=/srv/unishield/captures
UNISHIELD_LOGS_DIR=/var/log/unishield
UNISHIELD_ALERT_RETENTION_DAYS=90
# Analyst-side export files: inside StateDirectory, the only writable place
UNISHIELD_EXPORT_DIR=/var/lib/unishield/exports

UNISHIELD_ANONYMIZE_IPS=false
# UNISHIELD_IP_HASH_SALT=<long random value, if anonymize_ips is on>
